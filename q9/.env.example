# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead.

# Required: your Google AI Studio (Gemini) API key - free tier available,
# no credit card required for Flash / Flash-Lite models.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for the AI reading step.
# gemini-2.5-flash-lite has the most generous free-tier request limits;
# gemini-2.5-flash is a bit stronger if you have headroom.
MODEL_NAME=gemini-2.5-flash

# How many dossiers to send to the model in parallel during a single
# propose request (tune this to stay under the 55s per-request budget
# AND under Gemini's free-tier requests-per-minute limit)
MODEL_CONCURRENCY=8

# Where the SQLite database file lives.
# On Render, point this at a mounted persistent Disk, e.g. /var/data/mailroom.db
DB_PATH=./data.db

# Port the HTTP server listens on (Render sets PORT automatically)
PORT=3000
