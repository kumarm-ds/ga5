# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead.

# Required: your Google AI Studio (Gemini) API key - free tier available,
# no credit card required for Flash / Flash-Lite models.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for the AI reading step.
# gemini-2.5-flash-lite has the most generous free-tier request limits;
# gemini-2.5-flash is a bit stronger if you have headroom.
MODEL_NAME=gemini-2.5-flash

# How many dossiers go into ONE model call. Batching keeps total request
# count low enough to fit inside free-tier rate limits and the 55s budget
# (e.g. 67 dossiers / batch size 10 = ~7 calls instead of 67).
MODEL_BATCH_SIZE=10

# How many batches run concurrently. This directly multiplies your
# requests-per-minute against the model provider - keep it low on free tiers.
MODEL_CONCURRENCY=2

# Where the SQLite database file lives.
# On Render's free plan there's no persistent disk, so this is just local
# ephemeral storage - fine within a single running instance/Check.
DB_PATH=./data.db

# Port the HTTP server listens on (Render sets PORT automatically)
PORT=3000
