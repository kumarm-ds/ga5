# ---- AI provider (any OpenAI-compatible chat completions endpoint) ----
# Works with Groq, OpenRouter, Together, Gemini's OpenAI-compat endpoint,
# a local Ollama OpenAI-compat endpoint, etc. Model choice earns no marks.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=replace_me
AI_MODEL=llama-3.3-70b-versatile

# ---- Persistence (Upstash Redis, free tier — no Render disk needed) ----
# Create a free database at https://console.upstash.com -> Redis -> Create.
# Copy the "REST API" URL and token shown on the database's detail page.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_me

# Local port (Render sets PORT itself; leave unset on Render)
PORT=3000
