# ---- AI provider (any OpenAI-compatible chat completions endpoint) ----
# Works with Groq, OpenRouter, Together, Gemini's OpenAI-compat endpoint,
# a local Ollama OpenAI-compat endpoint, etc. Model choice earns no marks.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=replace_me
AI_MODEL=llama-3.3-70b-versatile

# Where SQLite stores state. On Render this should point at the mounted disk.
DB_PATH=./data/incident-agent.db

# Local port (Render sets PORT itself; leave unset on Render)
PORT=3000
