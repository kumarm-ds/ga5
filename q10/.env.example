# The exact public base URL you will submit for grading, e.g. https://your-app.onrender.com/a2a/
# MUST end with a trailing slash, no query/fragment/credentials.
BASE_URL=https://your-app.onrender.com/a2a/

# ---- AI provider (OpenAI-compatible chat completions endpoint) ----
# Works with OpenAI, Groq, OpenRouter, Together, local Ollama (via its OpenAI-compat endpoint), etc.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=replace_me
AI_MODEL=llama-3.1-8b-instant

# Optional: comma-separated Bearer tokens that are pre-authorized.
# If left empty, ANY non-empty Bearer token is accepted and treated as its own principal (user).
# This lets the grader use several different tokens to simulate different users for isolation tests.
# ALLOWED_TOKENS=secretA,secretB

PORT=3000
